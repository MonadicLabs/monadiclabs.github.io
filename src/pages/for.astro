---
import Layout from '../layouts/Layout.astro';

const audiences = [
  {
    title: 'Defense & public sector',
    body: "You need a platform that can pass a real security review — ANSSI-aligned, CIS-benchmarked — not one that just works in a demo. We build compliance in from the start instead of retrofitting it before an audit.",
    points: [
      'Security posture audits with remediation, not just a findings PDF',
      'Hardened embedded Linux images built for long-term maintenance',
      'Documentation in the format reviewers actually need',
    ],
  },
  {
    title: 'Commercial UAV / UGV operators',
    body: "Agriculture, inspection, and survey fleets that need onboard processing, a reliable datalink, and a companion computer that survives being flown every day — not a lab prototype.",
    points: [
      'PX4/Betaflight integration matched to your actual flight profile',
      'Onboard image processing and streaming, sized to the platform',
      'Fleet-ready provisioning, not one-off builds',
    ],
  },
  {
    title: 'Existing platforms',
    body: 'You already have something flying or deployed and you need a hard problem solved — a companion-computer integration, a compliance gap, a firmware bug that only shows up in the field.',
    points: [
      'Field failure investigation and root-cause analysis',
      'Firmware patches and OTA rollout for fleets already deployed',
      'Security remediation ahead of a compliance deadline',
    ],
  },
];
---

<Layout
  title="For You"
  description="Who Monadic Labs works with — defense and public-sector integrators, commercial UAV/UGV operators, and teams with an existing platform that needs a hard problem solved."
>
  <section class="container mx-auto px-5 py-16 sm:py-20">
    <p class="font-mono text-sm text-blue-400">~/for$</p>
    <h1 class="mt-2 font-display text-3xl font-semibold sm:text-4xl">Built for a few kinds of teams</h1>
    <p class="mt-4 max-w-xl text-muted">
      If you don't see yourself below, reach out anyway — this isn't an exhaustive list, it's the pattern we see most.
    </p>

    <div class="mt-14 space-y-14">
      {audiences.map((a) => (
        <div class="border-t border-line/60 pt-10 first:border-t-0 first:pt-0">
          <h2 class="font-display text-2xl font-semibold">{a.title}</h2>
          <p class="mt-3 max-w-2xl text-muted">{a.body}</p>
          <ul class="mt-5 space-y-1.5 text-sm text-muted">
            {a.points.map((p) => (
              <li class="flex gap-2">
                <span class="text-blue-500">›</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 rounded-md border border-blue-500/30 bg-panel p-8 text-center">
      <h2 class="font-display text-xl font-semibold">Not sure which one you are?</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted">
        Tell us what you're building and we'll tell you honestly whether it's a fit.
      </p>
      <a href="/contact#consult" class="btn-electric mt-5 inline-flex">Free consultation</a>
    </div>
  </section>
</Layout>
