---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { localePath, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** Path (in the *other* language) the language switcher should link to. Defaults to that language's homepage. */
  altHref?: string;
}
const { title, description, lang = 'en', altHref } = Astro.props as Props;
const otherLang: Locale = lang === 'en' ? 'fr' : 'en';
const resolvedAltHref = altHref ?? localePath(otherLang, '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Monadic Labs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply saved theme before paint to avoid a flash of the wrong theme.
      const saved = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', saved);
      // Marks JS as available so .reveal can safely start hidden (see global.css) —
      // without this, a no-JS visitor would never see the IntersectionObserver fire.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="terminal-bg text-fg">
    <div class="scanlines pointer-events-none fixed inset-0 z-50" aria-hidden="true"></div>
    <div class="relative flex min-h-screen flex-col">
      <Header lang={lang} altHref={resolvedAltHref} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <script>
      const revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
