---
import { localePath, type Locale } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props as Props;

const copy = {
  en: {
    eyebrow: '~/products$ ls',
    title: 'Products',
    lede: "Most of what we do is bespoke integration work. This is the one thing we've built once and now sell off the shelf, and one we are still building.",
    items: [
      {
        slug: 'spu',
        tag: 'HARDWARE',
        name: 'SPU — Swarm Processing Unit',
        tagline: 'On-board swarm autonomy that bolts onto any existing UAV — every unit plans for itself and keeps flying the mission when the operator link is gone.',
      },
      {
        slug: 'dsa',
        tag: 'SOFTWARE · WORK IN PROGRESS',
        name: 'DSA Module',
        tagline: 'Distributed situational awareness for the SPU — the swarm shares what it sees as keep-out zones and points of interest, over a thin radio link.',
      },
    ],
  },
  fr: {
    eyebrow: '~/produits$ ls',
    title: 'Produits',
    lede: "L'essentiel de notre travail est de l'intégration sur mesure. Voici la chose que nous avons construite une fois et vendons désormais sur étagère, et une que nous construisons encore.",
    items: [
      {
        slug: 'spu',
        tag: 'MATÉRIEL',
        name: 'SPU — Swarm Processing Unit',
        tagline: "Une autonomie d'essaim embarquée qui s'intègre à n'importe quel drone existant — chaque unité planifie seule et continue de voler la mission quand la liaison opérateur a disparu.",
      },
      {
        slug: 'dsa',
        tag: 'LOGICIEL · EN DÉVELOPPEMENT',
        name: 'DSA Module',
        tagline: "La perception distribuée du SPU — l'essaim partage ce qu'il voit sous forme de zones interdites et de points d'intérêt, sur une liaison radio mince.",
      },
    ],
  },
};

const c = copy[lang];
---

<section class="container mx-auto px-5 py-16 sm:py-20">
  <p class="font-mono text-sm text-blue-400">{c.eyebrow}</p>
  <h1 class="mt-2 font-display text-3xl font-semibold sm:text-4xl">{c.title}</h1>
  <p class="mt-4 max-w-xl text-muted">{c.lede}</p>

  <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
    {c.items.map((item) => (
      <a
        href={localePath(lang, `/products/${item.slug}`)}
        class="group block rounded-md border border-line bg-panel p-6 transition-colors hover:border-blue-500/40"
      >
        <span class="tag pointer-events-none">{item.tag}</span>
        <h2 class="mt-3 font-display text-xl font-semibold group-hover:text-blue-400">{item.name}</h2>
        <p class="mt-2 text-sm text-muted">{item.tagline}</p>
        <span class="accent-link mt-4 inline-block text-sm">→</span>
      </a>
    ))}
  </div>
</section>
