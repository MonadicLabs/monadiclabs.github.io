---
import { localePath, type Locale } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props as Props;

const copy = {
  en: {
    back: '← ~/products',
    tag: 'SOFTWARE',
    name: 'fleece',
    tagline: 'The coordination runtime underneath the SPU — and usable entirely on its own, on hardware we didn’t build.',
    body: "fleece is the software layer that makes a swarm behave like one system instead of N independent vehicles. Every node runs the same runtime: a gossip-synchronized shared-state store, an embedded JavaScript engine for authoring behavior as data, and goal-oriented mission planning built on top of that state — all sized for a microcontroller, not a companion computer. The SPU is fleece's proving ground, running it in production on real airframes, but fleece itself doesn't depend on the SPU's hardware, its autopilot bridge, or its ground-control protocol. It's a standalone runtime, already reusable by third parties as-is.",
    specsTitle: 'What it actually does',
    specs: [
      'Virtual stigmergy: a decentralized, eventually-consistent key-value store synced by last-write-wins gossip — no central database, no leader election',
      'QuickJS-embedded scripting: goals, actions, and behavior logic are authored as JavaScript, not compiled into the firmware — new behavior ships without a reflash',
      'GOAP mission planning on top of that state: goals and actions as data, one generic planner, automatic replanning as the world changes',
      "Reticulum mesh transport underneath: peer-to-peer and encrypted, no infrastructure to run — carries fleece's gossip over whatever radio the host provides",
      'CBOR-encoded state on the wire, sized for a bandwidth-constrained radio link, not Wi-Fi',
      'Conflict resolution by monotonic timestamp plus deterministic node-id tie-break — no application-level merge logic to get wrong',
    ],
    specsNote: "fleece is developed as its own git submodule on a dedicated branch, with no dependency baked in on any specific host firmware — the SPU is one integration of it, not the only one it was designed for.",
    useCasesTitle: 'Where it fits',
    useCases: [
      'The coordination layer for any fleet of constrained devices — aerial, ground, or otherwise — that has to keep working when connectivity does not',
      'Replacing a hand-rolled auction or bidding scheme with a native CBBA-style scored claim primitive — decentralized, no bidding round to implement yourself',
      'Authoring new fleet behavior as goals and actions instead of a hand-wired state machine, and shipping it without touching firmware',
    ],
    loopTitle: 'How the runtime actually loops',
    loopLede: 'One time-step loop, the same on every node, run continuously: state in, gossip merged, script executed, actuators driven — then it does it again.',
    ctaTitle: 'Building a fleet that needs this?',
    ctaBody: "Tell us what you're coordinating and what it runs on — we'll tell you what fits.",
    ctaButton: 'Get in touch',
    seeAlso: 'Looking for the hardware side? See the ',
    seeAlsoLink: 'SPU',
  },
  fr: {
    back: '← ~/produits',
    tag: 'LOGICIEL',
    name: 'fleece',
    tagline: "Le runtime de coordination sous le SPU — et utilisable entièrement seul, sur du matériel que nous n'avons pas conçu.",
    body: "fleece est la couche logicielle qui fait qu'un essaim se comporte comme un seul système plutôt que N véhicules indépendants. Chaque nœud exécute le même runtime : un magasin d'état partagé synchronisé par gossip, un moteur JavaScript embarqué pour écrire le comportement comme des données, et une planification de mission orientée objectifs construite sur cet état — le tout dimensionné pour un microcontrôleur, pas un calculateur compagnon. Le SPU est le terrain de preuve de fleece, l'exécutant en production sur de vrais appareils, mais fleece lui-même ne dépend ni du matériel du SPU, ni de son pont autopilote, ni de son protocole de contrôle-sol. C'est un runtime autonome, déjà réutilisable tel quel par des tiers.",
    specsTitle: 'Ce qu’il fait réellement',
    specs: [
      "Stigmergie virtuelle : un magasin clé-valeur décentralisé et à cohérence éventuelle, synchronisé par gossip last-write-wins — sans base de données centrale, sans élection de leader",
      "Scripting embarqué QuickJS : objectifs, actions et logique de comportement sont écrits en JavaScript, pas compilés dans le firmware — un nouveau comportement se déploie sans reflash",
      "Planification de mission GOAP au-dessus de cet état : objectifs et actions comme données, un planificateur générique, replanification automatique quand le monde change",
      "Transport maillé Reticulum en dessous : pair-à-pair et chiffré, sans infrastructure à faire tourner — porte le gossip de fleece sur n'importe quelle radio fournie par l'hôte",
      "État encodé en CBOR sur le lien — dimensionné pour une liaison radio à bande passante contrainte, pas du Wi-Fi",
      "Résolution de conflit par horodatage monotone et départage déterministe par id de nœud — aucune logique de fusion applicative à faire échouer",
    ],
    specsNote: "fleece est développé comme son propre sous-module git, sur une branche dédiée, sans dépendance intégrée envers un firmware hôte particulier — le SPU en est une intégration, pas la seule pour laquelle il a été conçu.",
    useCasesTitle: 'Cas d’usage',
    useCases: [
      "La couche de coordination pour toute flotte d'appareils contraints — aériens, terrestres ou autres — qui doit continuer à fonctionner quand la connectivité ne le fait pas",
      "Remplacer un schéma d'enchère ou de coordination codé sur mesure par une primitive native de revendication notée façon CBBA — décentralisée, sans round d'enchère à implémenter soi-même",
      "Écrire un nouveau comportement de flotte comme des objectifs et des actions plutôt qu'une machine à états codée à la main, et le déployer sans toucher au firmware",
    ],
    loopTitle: 'Comment le runtime boucle réellement',
    loopLede: "Une seule boucle temporelle, identique sur chaque nœud, exécutée en continu : état en entrée, gossip fusionné, script exécuté, actionneurs pilotés — puis elle recommence.",
    ctaTitle: 'Vous construisez une flotte qui en a besoin ?',
    ctaBody: "Dites-nous ce que vous coordonnez et sur quoi ça tourne — on vous dira ce qui convient.",
    ctaButton: 'Nous contacter',
    seeAlso: 'Vous cherchez le côté matériel ? Voir le ',
    seeAlsoLink: 'SPU',
  },
};

const c = copy[lang];
---

<section class="container mx-auto px-5 py-16 sm:py-20">
  <a href={localePath(lang, '/products')} class="font-mono text-sm text-blue-400">{c.back}</a>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <h1 class="font-display text-3xl font-semibold sm:text-4xl">{c.name}</h1>
    <span class="tag pointer-events-none">{c.tag}</span>
  </div>
  <p class="mt-2 max-w-2xl text-blue-400">{c.tagline}</p>
  <p class="mt-4 max-w-2xl text-sm text-muted">{c.body}</p>

  <div class="mt-10 rounded-md border border-blue-500/30 bg-panel p-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div>
        <h3 class="font-display text-base font-semibold">{c.specsTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.specs.map((s) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">{c.specsNote}</p>
      </div>
      <div>
        <h3 class="font-display text-base font-semibold">{c.useCasesTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.useCases.map((u) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{u}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-8 terminal-window">
    <div class="terminal-bar">
      <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
      ~/fleece/loop.svg
    </div>
    <div class="p-5">
      <h3 class="font-display text-base font-semibold">{c.loopTitle}</h3>
      <svg viewBox="0 0 820 260" class="mt-4 h-auto w-full" role="img" aria-label={c.loopTitle} font-family="var(--font-mono)">
        <defs>
          <marker id="loopArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="#1158ff"/>
          </marker>
        </defs>

        <rect x="16" y="80" width="170" height="90" rx="3" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
        <text x="101" y="112" fill="var(--fg)" font-size="10.5" text-anchor="middle" letter-spacing="0.5">1 · INPUT</text>
        <text x="101" y="130" fill="var(--muted)" font-size="8" text-anchor="middle">sensors, radio bytes</text>
        <text x="101" y="143" fill="var(--muted)" font-size="8" text-anchor="middle">in from the host</text>

        <line x1="188" y1="125" x2="228" y2="125" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loopArrow)"/>

        <rect x="232" y="80" width="170" height="90" rx="3" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
        <text x="317" y="112" fill="var(--fg)" font-size="10.5" text-anchor="middle" letter-spacing="0.5">2 · GOSSIP</text>
        <text x="317" y="130" fill="var(--muted)" font-size="8" text-anchor="middle">merge peer state,</text>
        <text x="317" y="143" fill="var(--muted)" font-size="8" text-anchor="middle">last-write-wins</text>

        <line x1="404" y1="125" x2="444" y2="125" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loopArrow)"/>

        <rect x="448" y="70" width="180" height="110" rx="3" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
        <text x="538" y="98" fill="#1158ff" font-size="11" font-weight="600" text-anchor="middle" letter-spacing="0.5">3 · SCRIPT</text>
        <text x="538" y="120" fill="var(--fg)" font-size="8.5" text-anchor="middle">QuickJS: GOAP planner</text>
        <text x="538" y="135" fill="var(--fg)" font-size="8.5" text-anchor="middle">+ authored behavior</text>
        <text x="538" y="155" fill="var(--muted)" font-size="7.5" text-anchor="middle">reads/writes shared state</text>

        <line x1="630" y1="125" x2="670" y2="125" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loopArrow)"/>

        <rect x="674" y="80" width="130" height="90" rx="3" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
        <text x="739" y="112" fill="var(--fg)" font-size="10.5" text-anchor="middle" letter-spacing="0.5">4 · OUTPUT</text>
        <text x="739" y="130" fill="var(--muted)" font-size="8" text-anchor="middle">actuators,</text>
        <text x="739" y="143" fill="var(--muted)" font-size="8" text-anchor="middle">mesh broadcast</text>

        <path d="M739,78 C739,15 101,15 101,78" fill="none" stroke="#3d84ff" stroke-width="1.5" stroke-dasharray="1 5" stroke-linecap="round" marker-end="url(#loopArrow)"/>
        <text x="420" y="30" fill="var(--muted)" font-size="8.5" text-anchor="middle" letter-spacing="0.5">SAME LOOP, EVERY NODE, CONTINUOUSLY</text>

        <text x="16" y="220" fill="var(--fg)" font-size="10.5">No node is a master — every node runs this exact loop, so there's no single</text>
        <text x="16" y="238" fill="var(--fg)" font-size="10.5">point of coordination failure, only individual nodes that can go quiet.</text>
      </svg>
      <p class="mt-4 text-xs text-muted">{c.loopLede}</p>
    </div>
  </div>

  <div class="mt-10 text-center">
    <h2 class="font-display text-xl font-semibold">{c.ctaTitle}</h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-muted">{c.ctaBody}</p>
    <a href={localePath(lang, '/contact')} class="btn-electric mt-5 inline-flex">{c.ctaButton}</a>
    <p class="mt-4 text-xs text-muted">
      {c.seeAlso}<a href={localePath(lang, '/products/spu')} class="accent-link">{c.seeAlsoLink}</a>.
    </p>
  </div>
</section>
