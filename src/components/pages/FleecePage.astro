---
import { localePath, type Locale } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props as Props;

const copy = {
  en: {
    back: '← ~/products',
    tag: 'SOFTWARE',
    name: 'fleece',
    tagline: 'The coordination runtime underneath the SPU — and usable entirely on its own, on hardware we didn’t build.',
    body: "fleece is the software layer that makes a swarm behave like one system instead of N independent vehicles. Every node runs the same runtime: a gossip-synchronized shared-state store, an embedded JavaScript engine for authoring behavior as data, and a bounded goal-oriented planner built on top of that state — all sized for a microcontroller, not a companion computer. The SPU is fleece's proving ground, but the runtime — whose current C++17 rewrite lives in its own repository, fleece-ng — doesn't depend on the SPU's hardware, its autopilot bridge, or its ground-control protocol. It's a standalone runtime, reusable by third parties as-is.",
    specsTitle: 'What it actually does',
    specs: [
      'Virtual stigmergy: a decentralized, eventually-consistent key-value store synced by last-write-wins gossip — no central database, no leader election',
      'QuickJS-embedded scripting: goals, actions, and behavior logic are authored as JavaScript, not compiled into the firmware — new behavior ships without a reflash',
      'Goal-oriented mission planning on top of that state: one bounded, receding-horizon planner over goals and actions authored as data — it replans as the world changes, and a goal carrying a deadline it cannot reach in time is refused up front rather than failed mid-mission',
      "A stateless replication fabric underneath: every node streams a rateless code of its state and decodes whatever it hears — no handshakes, no requests, no sessions — over whatever broadcast radio the host provides, with every frame authenticated",
      'CBOR-encoded state on the wire, sized for a bandwidth-constrained radio link, not Wi-Fi',
      'Conflict resolution by monotonic timestamp plus deterministic node-id tie-break — no application-level merge logic to get wrong',
    ],
    specsNote: "fleece is developed as its own project — the current runtime is its C++17 rewrite, fleece-ng — with no dependency baked in on any specific host firmware. The SPU is one integration of it, not the only one it was designed for.",
    useCasesTitle: 'Where it fits',
    useCases: [
      'The coordination layer for any fleet of constrained devices — aerial, ground, or otherwise — that has to keep working when connectivity does not',
      'Replacing a hand-rolled auction or bidding scheme with a native CBBA-style scored claim primitive — decentralized, no bidding round to implement yourself',
      'Authoring new fleet behavior as goals and actions instead of a hand-wired state machine, and shipping it without touching firmware',
    ],
    loopTitle: 'How the runtime actually loops',
    loopLede: 'One time-step loop, the same on every node, run continuously: state in, gossip merged, script executed, actuators driven — then it does it again. No node is a master, so there is no single point of coordination failure, only individual nodes that can go quiet.',
    ctaTitle: 'Building a fleet that needs this?',
    ctaBody: "Tell us what you're coordinating and what it runs on — we'll tell you what fits.",
    ctaButton: 'Get in touch',
    seeAlso: 'Looking for the hardware side? See the ',
    seeAlsoLink: 'SPU',
  },
  fr: {
    back: '← ~/produits',
    tag: 'LOGICIEL',
    name: 'fleece',
    tagline: "Le runtime de coordination sous le SPU — et utilisable entièrement seul, sur du matériel que nous n'avons pas conçu.",
    body: "fleece est la couche logicielle qui fait qu'un essaim se comporte comme un seul système plutôt que N véhicules indépendants. Chaque nœud exécute le même runtime : un magasin d'état partagé synchronisé par gossip, un moteur JavaScript embarqué pour écrire le comportement comme des données, et un planificateur orienté objectifs, borné, construit sur cet état — le tout dimensionné pour un microcontrôleur, pas un calculateur compagnon. Le SPU est le terrain de preuve de fleece, mais le runtime — dont la réécriture actuelle en C++17 vit dans son propre dépôt, fleece-ng — ne dépend ni du matériel du SPU, ni de son pont autopilote, ni de son protocole de contrôle-sol. C'est un runtime autonome, réutilisable tel quel par des tiers.",
    specsTitle: 'Ce qu’il fait réellement',
    specs: [
      "Stigmergie virtuelle : un magasin clé-valeur décentralisé et à cohérence éventuelle, synchronisé par gossip last-write-wins — sans base de données centrale, sans élection de leader",
      "Scripting embarqué QuickJS : objectifs, actions et logique de comportement sont écrits en JavaScript, pas compilés dans le firmware — un nouveau comportement se déploie sans reflash",
      "Planification de mission orientée objectifs au-dessus de cet état : un unique planificateur borné à horizon fuyant sur des objectifs et des actions écrits comme des données — il replanifie quand le monde change, et un objectif portant une échéance qu'il ne peut atteindre à temps est refusé d'emblée plutôt qu'échoué en cours de mission",
      "Une couche de réplication sans état en dessous : chaque nœud diffuse un code sans rendement fixe de son état et décode tout ce qu'il entend — sans échange préalable, sans requête, sans session — sur n'importe quelle radio de diffusion fournie par l'hôte, chaque trame authentifiée",
      "État encodé en CBOR sur le lien — dimensionné pour une liaison radio à bande passante contrainte, pas du Wi-Fi",
      "Résolution de conflit par horodatage monotone et départage déterministe par id de nœud — aucune logique de fusion applicative à faire échouer",
    ],
    specsNote: "fleece est développé comme son propre projet — le runtime actuel en est la réécriture C++17, fleece-ng — sans dépendance intégrée envers un firmware hôte particulier. Le SPU en est une intégration, pas la seule pour laquelle il a été conçu.",
    useCasesTitle: 'Cas d’usage',
    useCases: [
      "La couche de coordination pour toute flotte d'appareils contraints — aériens, terrestres ou autres — qui doit continuer à fonctionner quand la connectivité ne le fait pas",
      "Remplacer un schéma d'enchère ou de coordination codé sur mesure par une primitive native de revendication notée façon CBBA — décentralisée, sans round d'enchère à implémenter soi-même",
      "Écrire un nouveau comportement de flotte comme des objectifs et des actions plutôt qu'une machine à états codée à la main, et le déployer sans toucher au firmware",
    ],
    loopTitle: 'Comment le runtime boucle réellement',
    loopLede: "Une seule boucle temporelle, identique sur chaque nœud, exécutée en continu : état en entrée, gossip fusionné, script exécuté, actionneurs pilotés — puis elle recommence. Aucun nœud n'est maître : il n'y a donc pas de point de défaillance unique de la coordination, seulement des nœuds qui peuvent se taire.",
    ctaTitle: 'Vous construisez une flotte qui en a besoin ?',
    ctaBody: "Dites-nous ce que vous coordonnez et sur quoi ça tourne — on vous dira ce qui convient.",
    ctaButton: 'Nous contacter',
    seeAlso: 'Vous cherchez le côté matériel ? Voir le ',
    seeAlsoLink: 'SPU',
  },
};

const c = copy[lang];
---

<section class="container mx-auto px-5 py-16 sm:py-20">
  <a href={localePath(lang, '/products')} class="font-mono text-sm text-blue-400">{c.back}</a>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <h1 class="font-display text-3xl font-semibold sm:text-4xl">{c.name}</h1>
    <span class="tag pointer-events-none">{c.tag}</span>
  </div>
  <p class="mt-2 max-w-2xl text-blue-400">{c.tagline}</p>
  <p class="mt-4 max-w-2xl text-sm text-muted">{c.body}</p>

  <div class="mt-10 rounded-md border border-blue-500/30 bg-panel p-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div>
        <h3 class="font-display text-base font-semibold">{c.specsTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.specs.map((s) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">{c.specsNote}</p>
      </div>
      <div>
        <h3 class="font-display text-base font-semibold">{c.useCasesTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.useCases.map((u) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{u}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-8 terminal-window">
    <div class="terminal-bar">
      <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
      ~/fleece/loop.svg
    </div>
    <div class="p-5">
      <h3 class="font-display text-base font-semibold">{c.loopTitle}</h3>
      <svg viewBox="0 0 852 196" class="mt-4 h-auto w-full" role="img" aria-label={c.loopTitle} font-family="var(--font-mono)">
        <defs>
          <marker id="loopArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,1 L9,5 L0,9 z" fill="#1158ff"/>
          </marker>
        </defs>

        <path d="M730,60 C730,20 122,20 122,60" fill="none" stroke="#1158ff" stroke-width="1.4" marker-end="url(#loopArrow)"/>
        <text x="426" y="17" fill="var(--muted)" font-size="9" text-anchor="middle" letter-spacing="1.4">SAME LOOP · EVERY NODE · CONTINUOUSLY</text>

        <rect x="16" y="60" width="180" height="100" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
        <text x="106" y="95" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">1 · INPUT</text>
        <text x="106" y="118" fill="var(--muted)" font-size="10" text-anchor="middle">sensors, radio bytes</text>
        <text x="106" y="134" fill="var(--muted)" font-size="10" text-anchor="middle">in from the host</text>

        <line x1="196" y1="110" x2="222" y2="110" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loopArrow)"/>

        <rect x="224" y="60" width="180" height="100" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
        <text x="314" y="95" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">2 · GOSSIP</text>
        <text x="314" y="118" fill="var(--muted)" font-size="10" text-anchor="middle">merge peer state,</text>
        <text x="314" y="134" fill="var(--muted)" font-size="10" text-anchor="middle">last-write-wins</text>

        <line x1="404" y1="110" x2="430" y2="110" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loopArrow)"/>

        <rect x="432" y="52" width="180" height="116" rx="6" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
        <text x="522" y="86" fill="#1158ff" font-size="13" font-weight="600" text-anchor="middle" letter-spacing="0.8">3 · SCRIPT</text>
        <text x="522" y="110" fill="var(--fg)" font-size="10" text-anchor="middle">bounded GOAP planner</text>
        <text x="522" y="125" fill="var(--fg)" font-size="10" text-anchor="middle">+ authored behavior</text>
        <text x="522" y="147" fill="var(--muted)" font-size="8.5" text-anchor="middle">reads / writes shared state</text>

        <line x1="612" y1="110" x2="638" y2="110" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loopArrow)"/>

        <rect x="640" y="60" width="180" height="100" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
        <text x="730" y="95" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">4 · OUTPUT</text>
        <text x="730" y="118" fill="var(--muted)" font-size="10" text-anchor="middle">actuators,</text>
        <text x="730" y="134" fill="var(--muted)" font-size="10" text-anchor="middle">mesh broadcast</text>
      </svg>
      <p class="mt-4 text-xs text-muted">{c.loopLede}</p>
    </div>
  </div>

  <div class="mt-10 text-center">
    <h2 class="font-display text-xl font-semibold">{c.ctaTitle}</h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-muted">{c.ctaBody}</p>
    <a href={localePath(lang, '/contact')} class="btn-electric mt-5 inline-flex">{c.ctaButton}</a>
    <p class="mt-4 text-xs text-muted">
      {c.seeAlso}<a href={localePath(lang, '/products/spu')} class="accent-link">{c.seeAlsoLink}</a>.
    </p>
  </div>
</section>
