---
import { getCollection } from 'astro:content';
import { localePath, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props as Props;

const work = (await getCollection('work'))
  .filter((w) => w.data.featured)
  .sort((a, b) => Number(b.data.year) - Number(a.data.year));

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const copy = {
  en: {
    promptLine: '~/monadiclabs$',
    h1a: 'We build the platform',
    h1b: 'and',
    h1c: 'the software that runs it.',
    lede: "Monadic Labs is a full-stack engineering practice — embedded firmware, embedded Linux, autonomy integration for UAV/UGV platforms, and the security compliance work most shops skip. One team, fixed price, start to finish.",
    ctaStart: 'Start a project',
    ctaWork: 'View work',
    terminal: [
      '$ cat engagement.status',
      '→ discovery ................ done',
      '→ companion computer bring-up  done',
      '→ px4 integration ........... in progress',
      '→ security review ........... queued',
      '→ ground control link ....... queued',
    ],
    servicesEyebrow: '~/services$',
    servicesTitle: 'What we do',
    services: [
      {
        title: 'Embedded firmware',
        body: 'RTOS or bare-metal, sized to the timing constraints — sensor drivers, control loops, comms stacks.',
        tags: ['RTOS', 'Bare-metal', 'C / C++', 'OTA'],
      },
      {
        title: 'Embedded Linux',
        body: 'Yocto-based images from first bring-up to a hardened, production-ready platform.',
        tags: ['Yocto', 'Board bring-up', 'BSP', 'OTA'],
      },
      {
        title: 'UAV / UGV integration',
        body: 'Companion computers, sensor integration, PX4/Betaflight customization, datalink and GIS/C2.',
        tags: ['PX4', 'Betaflight', 'MAVLink', 'GIS/C2'],
      },
      {
        title: 'Security & compliance',
        body: 'CIS-benchmark and ANSSI-aligned audits, with remediation — not just a findings PDF.',
        tags: ['ANSSI', 'CIS benchmarks', 'Hardening', 'Audit'],
      },
    ],
    servicesMore: 'See the full service breakdown →',
    capsEyebrow: '~/capabilities$',
    capabilities: [
      'RTOS', 'Bare-metal firmware', 'Embedded Linux', 'Yocto', 'PX4', 'Betaflight',
      'MAVLink', 'Companion computers', 'Sensor integration', 'Image processing',
      'Onboard AI inference', 'Video streaming', 'Datalink', 'GIS / C2', 'ANSSI compliance',
      'CIS benchmarks', 'PCB design (via partners)', 'Mechanical design (via partners)',
    ],
    workEyebrow: '~/work$ ls -la',
    workTitle: 'Selected work',
    workAll: 'All work →',
    productsEyebrow: '~/products$',
    productsTitle: 'Off-the-shelf: the SPU',
    productsBody: "Our Swarm Processing Unit is a ready-to-use companion computer for UAV/UGV fleets — built for the integration work we do every day, available on its own.",
    productsCta: 'See the SPU →',
    forEyebrow: '~/for$',
    forTitle: 'Built for a few kinds of teams',
    forCards: [
      { title: 'Defense & public sector', body: 'Integrators and operators who need a platform that passes a real security review, not just a demo.' },
      { title: 'Commercial UAV/UGV operators', body: 'Agriculture, inspection, and survey fleets that need onboard processing and a reliable datalink, not a lab prototype.' },
      { title: 'Existing platforms', body: 'A platform already flying that needs a hard problem solved — integration, compliance, or a firmware bug that only shows up in the field.' },
    ],
    forMore: 'Read more about who we work with →',
    consultTitle: 'Not sure where to start?',
    consultBody: "Answer a few questions about what you're building and we'll tell you honestly whether it's a fit — including if the answer is \"don't build this yet.\"",
    consultCta: 'Free consultation',
    pricingEyebrow: '~/pricing$ cat pricing.txt',
    pricingTitle: 'Fixed price where we can be, day rate where we can’t.',
    pricingCta: 'Full pricing & FAQ',
    notesEyebrow: '~/notes$ tail -n 3',
    notesTitle: 'Field notes',
    notesAll: 'All notes →',
  },
  fr: {
    promptLine: '~/monadiclabs$',
    h1a: 'On construit la plateforme',
    h1b: 'et',
    h1c: 'le logiciel qui la fait tourner.',
    lede: "Monadic Labs est un bureau d'ingénierie full-stack — firmware embarqué, Linux embarqué, intégration autonomie pour plateformes UAV/UGV, et la conformité sécurité que la plupart des prestataires zappent. Une seule équipe, prix fixe, de bout en bout.",
    ctaStart: 'Démarrer un projet',
    ctaWork: 'Voir nos réalisations',
    terminal: [
      '$ cat engagement.status',
      '→ découverte ................ terminé',
      '→ bring-up calculateur ....... terminé',
      '→ intégration px4 ............ en cours',
      '→ revue sécurité ............. en attente',
      '→ liaison sol ................ en attente',
    ],
    servicesEyebrow: '~/services$',
    servicesTitle: 'Ce que nous faisons',
    services: [
      {
        title: 'Firmware embarqué',
        body: 'RTOS ou bare-metal, selon les contraintes temporelles — pilotes capteurs, boucles de contrôle, piles de communication.',
        tags: ['RTOS', 'Bare-metal', 'C / C++', 'OTA'],
      },
      {
        title: 'Linux embarqué',
        body: "Images basées sur Yocto, du premier bring-up jusqu'à une plateforme durcie, prête pour la production.",
        tags: ['Yocto', 'Bring-up carte', 'BSP', 'OTA'],
      },
      {
        title: 'Intégration UAV / UGV',
        body: 'Calculateurs embarqués, intégration capteurs, personnalisation PX4/Betaflight, liaison de données et GIS/C2.',
        tags: ['PX4', 'Betaflight', 'MAVLink', 'GIS/C2'],
      },
      {
        title: 'Sécurité & conformité',
        body: 'Audits alignés CIS et ANSSI, avec remédiation — pas juste un PDF de constats.',
        tags: ['ANSSI', 'CIS benchmarks', 'Durcissement', 'Audit'],
      },
    ],
    servicesMore: 'Voir le détail complet des services →',
    capsEyebrow: '~/capabilities$',
    capabilities: [
      'RTOS', 'Firmware bare-metal', 'Linux embarqué', 'Yocto', 'PX4', 'Betaflight',
      'MAVLink', 'Calculateurs embarqués', 'Intégration capteurs', 'Traitement d’image',
      'Inférence IA embarquée', 'Streaming vidéo', 'Liaison de données', 'GIS / C2', 'Conformité ANSSI',
      'CIS benchmarks', 'Conception PCB (via partenaires)', 'Conception mécanique (via partenaires)',
    ],
    workEyebrow: '~/work$ ls -la',
    workTitle: 'Réalisations sélectionnées',
    workAll: 'Toutes les réalisations →',
    productsEyebrow: '~/products$',
    productsTitle: 'Sur étagère : le SPU',
    productsBody: "Notre Swarm Processing Unit est un calculateur embarqué prêt à l'emploi pour flottes UAV/UGV — conçu à partir de notre travail d'intégration quotidien, disponible seul.",
    productsCta: 'Découvrir le SPU →',
    forEyebrow: '~/for$',
    forTitle: "Pensé pour plusieurs profils d'équipes",
    forCards: [
      { title: 'Défense & secteur public', body: 'Intégrateurs et opérateurs qui ont besoin d’une plateforme capable de passer une vraie revue de sécurité, pas juste une démo.' },
      { title: 'Opérateurs UAV/UGV civils', body: 'Agriculture, inspection, relevé — des flottes qui ont besoin de traitement embarqué et d’une liaison fiable, pas d’un prototype de labo.' },
      { title: 'Plateformes existantes', body: 'Une plateforme déjà en vol qui a besoin d’un problème difficile résolu — intégration, conformité, ou un bug firmware qui n’apparaît qu’en conditions réelles.' },
    ],
    forMore: 'En savoir plus sur nos clients →',
    consultTitle: 'Pas sûr par où commencer ?',
    consultBody: "Répondez à quelques questions sur votre projet et nous vous dirons honnêtement si c'est pertinent — y compris si la réponse est « n'y allez pas encore ».",
    consultCta: 'Consultation gratuite',
    pricingEyebrow: '~/pricing$ cat pricing.txt',
    pricingTitle: 'Prix fixe quand c’est possible, taux journalier sinon.',
    pricingCta: 'Tarifs complets & FAQ',
    notesEyebrow: '~/notes$ tail -n 3',
    notesTitle: 'Notes de terrain',
    notesAll: 'Toutes les notes →',
  },
};

const c = copy[lang];
const dateLocale = lang === 'fr' ? 'fr-FR' : 'en-US';
---

<section class="container mx-auto px-5 pb-16 pt-16 sm:pt-24">
  <div class="reveal mx-auto flex max-w-3xl flex-col items-center text-center">
    <img
      src="/assets/logo/logo-lockup-alt.png"
      alt="Monadic Labs"
      class="dark-only mb-8 h-auto w-full max-w-md sm:max-w-lg"
    />
    <img
      src="/assets/logo/logo-mark.png"
      alt="Monadic Labs"
      class="light-only glow-blue-box mb-8 h-40 w-40 sm:h-48 sm:w-48"
    />
    <p class="prompt mb-4 font-mono text-sm">{c.promptLine} <span class="prompt-cursor"></span></p>
    <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight sm:text-5xl md:text-6xl">
      {c.h1a}<br class="hidden sm:block" /> <span class="glow-blue text-blue-500">{c.h1b}</span> {c.h1c}
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-balance text-base text-muted sm:text-lg">{c.lede}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={localePath(lang, '/contact')} class="btn-electric">{c.ctaStart}</a>
      <a href="/work" class="btn-ghost">{c.ctaWork}</a>
    </div>
  </div>

  <div class="reveal mx-auto mt-14 max-w-3xl">
    <div class="terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        monadic.sys — 80×24 · utf-8
      </div>
      <div class="space-y-2 p-5 font-mono text-sm text-mono-300">
        <p><span class="text-blue-400">{c.terminal[0].slice(0, 1)}</span> {c.terminal[0].slice(2)}</p>
        {c.terminal.slice(1).map((line) => <p class="text-mono-400">{line}</p>)}
        <p class="mt-2"><span class="text-blue-400">$</span> <span class="prompt-cursor"></span></p>
      </div>
    </div>
  </div>
</section>

<section id="services" class="border-t border-line/60 bg-panel/40">
  <div class="container mx-auto px-5 py-20">
    <div class="reveal mb-10">
      <p class="font-mono text-sm text-blue-400">{c.servicesEyebrow}</p>
      <h2 class="mt-2 font-display text-2xl font-semibold sm:text-3xl">{c.servicesTitle}</h2>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {c.services.map((s) => (
        <div class="reveal rounded-md border border-line bg-panel p-6 transition-colors hover:border-blue-500/40">
          <h3 class="font-display text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-muted">{s.body}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {s.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>
    <div class="reveal mt-8">
      <a href={localePath(lang, '/services')} class="accent-link text-sm font-medium">{c.servicesMore}</a>
    </div>
  </div>
</section>

<section class="border-t border-line/60">
  <div class="container mx-auto px-5 py-16">
    <p class="reveal font-mono text-sm text-blue-400">{c.capsEyebrow}</p>
    <div class="reveal mt-5 flex flex-wrap gap-2.5">
      {c.capabilities.map((cap) => (
        <a href={localePath(lang, '/contact')} class="tag">{cap}</a>
      ))}
    </div>
  </div>
</section>

<section id="work" class="border-t border-line/60 bg-panel/40">
  <div class="container mx-auto px-5 py-20">
    <div class="reveal mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-sm text-blue-400">{c.workEyebrow}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold sm:text-3xl">{c.workTitle}</h2>
      </div>
      <a href="/work" class="accent-link hidden text-sm font-medium sm:inline">{c.workAll}</a>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {work.map((w) => (
        <a href={`/work/${w.id}`} class="reveal group block rounded-md border border-line bg-panel p-6 transition-colors hover:border-blue-500/40">
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-xs text-muted">{w.data.client} · {w.data.year}</span>
            <span class="font-mono text-xs text-blue-400 opacity-0 transition-opacity group-hover:opacity-100">open →</span>
          </div>
          <h3 class="mt-3 font-display text-xl font-semibold">{w.data.title}</h3>
          <p class="mt-2 text-sm text-muted">{w.data.summary}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {w.data.discipline.map((d) => <span class="tag">{d}</span>)}
          </div>
        </a>
      ))}
    </div>
    <a href="/work" class="accent-link mt-8 inline-block text-sm font-medium sm:hidden">{c.workAll}</a>
  </div>
</section>

<section class="border-t border-line/60">
  <div class="container mx-auto px-5 py-20">
    <div class="reveal flex flex-col items-start gap-6 rounded-md border border-blue-500/30 bg-panel p-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-mono text-sm text-blue-400">{c.productsEyebrow}</p>
        <h2 class="mt-2 font-display text-xl font-semibold sm:text-2xl">{c.productsTitle}</h2>
        <p class="mt-2 max-w-lg text-sm text-muted">{c.productsBody}</p>
      </div>
      <a href={localePath(lang, '/products')} class="btn-electric shrink-0">{c.productsCta}</a>
    </div>
  </div>
</section>

<section class="border-t border-line/60 bg-panel/40">
  <div class="container mx-auto px-5 py-20">
    <p class="reveal font-mono text-sm text-blue-400">{c.forEyebrow}</p>
    <h2 class="reveal mt-2 font-display text-2xl font-semibold sm:text-3xl">{c.forTitle}</h2>
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
      {c.forCards.map((card) => (
        <div class="reveal rounded-md border border-line bg-panel p-6">
          <h3 class="font-display text-lg font-semibold">{card.title}</h3>
          <p class="mt-2 text-sm text-muted">{card.body}</p>
        </div>
      ))}
    </div>
    <div class="reveal mt-8">
      <a href="/for" class="accent-link text-sm font-medium">{c.forMore}</a>
    </div>
  </div>
</section>

<section id="consult" class="border-t border-line/60">
  <div class="container mx-auto px-5 py-20">
    <div class="reveal mx-auto max-w-2xl rounded-md border border-blue-500/30 bg-panel p-8 text-center">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">{c.consultTitle}</h2>
      <p class="mx-auto mt-3 max-w-md text-sm text-muted">{c.consultBody}</p>
      <a href={`${localePath(lang, '/contact')}#consult`} class="btn-electric mt-6 inline-flex">{c.consultCta}</a>
    </div>
  </div>
</section>

<section class="border-t border-line/60 bg-panel/40">
  <div class="container mx-auto px-5 py-16">
    <div class="reveal flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <p class="font-mono text-sm text-blue-400">{c.pricingEyebrow}</p>
        <h2 class="mt-2 font-display text-xl font-semibold">{c.pricingTitle}</h2>
      </div>
      <a href={localePath(lang, '/pricing')} class="btn-ghost shrink-0">{c.pricingCta}</a>
    </div>
  </div>
</section>

<section class="border-t border-line/60">
  <div class="container mx-auto px-5 py-20">
    <div class="reveal mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-sm text-blue-400">{c.notesEyebrow}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold sm:text-3xl">{c.notesTitle}</h2>
      </div>
      <a href="/notes" class="accent-link hidden text-sm font-medium sm:inline">{c.notesAll}</a>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {notes.map((n) => (
        <a href={`/notes/${n.id}`} class="reveal group block rounded-md border border-line bg-panel p-6 transition-colors hover:border-blue-500/40">
          <time class="font-mono text-xs text-muted">{n.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}</time>
          <h3 class="mt-3 font-display text-base font-semibold group-hover:text-blue-400">{n.data.title}</h3>
          <p class="mt-2 text-sm text-muted">{n.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
