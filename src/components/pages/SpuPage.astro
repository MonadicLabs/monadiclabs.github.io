---
import { localePath, type Locale } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props as Props;

const copy = {
  en: {
    back: '← ~/products',
    tag: 'HARDWARE',
    name: 'SPU — Swarm Processing Unit',
    tagline: 'Decentralized swarm coordination that bolts onto any existing UAV — without owning the airframe or the flight stack.',
    body: "Most swarm products either replace your flight stack or route every coordination decision through a ground station and a live link. The SPU does neither. It rides alongside your existing autopilot as a companion module and handles coordination entirely over its own mesh — synchronized shared state and goal-directed mission planning, running identically on every unit. Cut the link to the operator, and the swarm keeps flying the mission. That's not a fallback mode; it's the design.",
    specsTitle: 'Specifications',
    specs: [
      'Zephyr RTOS firmware, one image — drone or ground-control role set at configuration time',
      'Decentralized coordination runtime (fleece): gossip-synchronized shared state plus goal-oriented mission planning, running on every unit',
      'Its own mesh radio link (Reticulum) — no internet, no cloud, no single point of failure',
      'MAVLink bridge to the autopilot today; BetaFlight/MSP support planned behind the same interface',
      'CBBA-style scored auction over shared state — compare-and-set bids, no central coordinator, a claim reassigns automatically if lost or outbid',
      'Ground-control role runs the identical firmware image and exposes a separate admin/telemetry link — swarm management software never touches the mesh wire format',
    ],
    specsNote: 'Board-level specifics — dimensions, power draw, pricing, final SKU — are still being finalized. Everything above is already real and verified, not projected: the coordination runtime, the mesh, and the mission logic it runs today.',
    useCasesTitle: 'Where it fits',
    useCases: [
      "Search-and-rescue and defense fleets that need coordination to survive a degraded or jammed link, not just when everything's working",
      'Standardizing coordination across a mixed fleet of airframes without a bespoke integration per aircraft',
      'Adding swarm behavior — search, claim, deliver — to an existing autopilot without touching its flight code',
    ],
    archTitle: 'How it fits onto an existing aircraft',
    archLede: 'One firmware image. The mesh keeps coordinating even if the link to this ground station is degraded or cut — that link was never load-bearing.',
    goapTitle: 'GOAP — how the mission logic actually works',
    goapLede: "Goals and actions are authored as data, not hand-wired control flow: each goal carries a satisfied-when condition and a utility score, each action a precondition and an effect. The planner just picks whichever achievable goal scores highest right now and searches a path to it. When the world changes — a target found, a cell already claimed, a link degraded — it replans from the new state instead of needing an explicit case for every situation. Adding new mission behavior means adding a goal and an action, not touching the planner or the firmware, and it can be uploaded over the mesh to a flying drone with no reflash.",
    editorTag: 'MISSION AUTHORING',
    editorTitle: 'What fleece can author: loiter, discover, deliver',
    editorLede: "fleece GOAP Studio lets you build a plan like this from scratch: three actions and three goals, each with a utility curve, nothing hand-wired — hold position until there's work, discover targets across an assigned grid cell by cell, then deliver to each one found. That's fleece's own general authoring model — goals and actions as data, the same way a third party building directly on fleece would. SPU ships something narrower today: a fixed, compiled-in action library (takeoff, goto, return_home, scan, deliver), so a mission on SPU hardware is goal data pushed to that library, not a custom plan.",
    editorNote: "Describes fleece's general authoring model, not how SPU missions are authored today — see the specifications above for what SPU actually ships.",
    autonomyTag: 'AUTONOMY',
    autonomyTitle: 'Upload once. The link was never load-bearing.',
    autonomyLede: "Push a plan from the GC-SPU and it travels over the mesh to every flying unit, once — not a command stream, not a live control loop. That's fleece's own general model. SPU ships a narrower version of it today: goals, not a custom plan, travel the same way over the same mesh to a fixed action library already running on every unit — pushed once each, picked up, and pursued independently from there. Either way, once something is on the mesh each unit plans and replans on its own, straight off shared world state gossiped peer to peer. Losing the link to the operator doesn't pause anything: nothing about how a unit plans ever depended on that link being up, so there's nothing to fail over to.",
    autonomyBeforeLabel: 'UPLOAD — ONE PUSH OVER THE MESH',
    autonomyAfterLabel: 'LINK CUT — EVERY UNIT STILL PLANNING, STILL COORDINATING',
    gcsTag: 'GROUND CONTROL',
    gcsTitle: 'The same board runs the ground station, too',
    gcsLede: "There's no separate ground-control product. Flash the identical SPU firmware image, set its role to ground-control at configuration time, and it becomes a GC-SPU — a mesh peer that happens to sit at the operator's desk instead of on an airframe. It exposes a real-time tactical picture over its own admin/telemetry link: live position and heading per unit, battery, link budget, mission state, one shared world model synced straight off the mesh gossip — not a cloud dashboard polling a database.",
    gcsPoints: [
      'Every unit the mesh can hear shows up live — position, heading, battery, link stats — on a real map, not a schematic',
      'Click a unit to pull its full telemetry; draw zones and points of interest straight onto the map for the swarm to react to',
      'Author or upload a GOAP mission plan and push it to a flying unit over the mesh — no reflash, no ground-station-specific protocol for the mesh side to worry about',
      "Runs entirely off the mesh's own gossip state — no internet, no cloud backend, nothing to stand up beyond the GC-SPU itself",
    ],
    gcsImgOverviewAlt: 'swarmpu ground-control tactical map — a unit tracked live over real street geography, dark HUD chrome',
    gcsImgSelectedAlt: 'swarmpu ground-control tactical map with a unit selected, showing live battery and link telemetry',
    roadmapTag: 'ROADMAP — NOT YET SHIPPED',
    roadmapTitle: "What's next: sensor-driven target discovery",
    roadmapLede: "In design, kept deliberately separate from the specifications above: nothing here is built or verified yet. The idea — an external sensor payload (an INS-backed camera, integrated the same way the autopilot already is: a dedicated link, not owned or run by the SPU) emits a bearing ray toward a detected target instead of a location guess. Rays from multiple units gossip through the same shared state the mesh already carries everything else over; as more of them arrive for the same target, triangulating their intersection converges on a location estimate. Once confident enough, that estimate becomes an ordinary goal in the exact same auction described above — no new coordination primitive, just another goal a unit can claim and pursue.",
    roadmapPoints: [
      'The SPU never runs the detection model or owns the sensor payload — the same relationship it already has with the autopilot',
      'A single ray is not a location: confidence builds as rays accumulate and geometry improves, not on the first sighting',
      'Once triangulated, the target is a goal like any other — claimed, contested, and reassigned on loss through the same auction',
    ],
    ctaTitle: 'Want a datasheet, a quote, or to talk integration?',
    ctaBody: "Tell us about your platform, your fleet size, or what you're coordinating — we'll get you the details.",
    ctaButton: 'Get in touch',
    seeAlso: 'The coordination underneath this is ',
    seeAlsoLink: 'fleece',
    seeAlsoRest: " — our own runtime, and its own product.",
  },
  fr: {
    back: '← ~/produits',
    tag: 'MATÉRIEL',
    name: 'SPU — Swarm Processing Unit',
    tagline: "Une coordination d'essaim décentralisée qui s'intègre à n'importe quel drone existant — sans posséder la cellule ni la chaîne de vol.",
    body: "La plupart des produits d'essaim remplacent votre chaîne de vol, ou font transiter chaque décision de coordination par une station sol et une liaison active. Le SPU ne fait ni l'un ni l'autre. Il s'intègre à votre autopilote existant comme module compagnon et gère la coordination entièrement sur son propre maillage — état partagé synchronisé et planification de mission orientée objectifs, identique sur chaque unité. Coupez la liaison avec l'opérateur, et l'essaim continue de voler la mission. Ce n'est pas un mode dégradé : c'est la conception elle-même.",
    specsTitle: 'Caractéristiques',
    specs: [
      "Firmware Zephyr RTOS, une seule image — rôle drone ou contrôle-sol défini à la configuration",
      "Runtime de coordination décentralisé (fleece) : état partagé synchronisé par gossip et planification de mission orientée objectifs, identique sur chaque unité",
      "Sa propre liaison radio maillée (Reticulum) — sans internet, sans cloud, sans point de défaillance unique",
      "Pont MAVLink vers l'autopilote aujourd'hui ; support BetaFlight/MSP prévu derrière la même interface",
      "Enchère de type CBBA sur l'état partagé — revendications compare-and-set, sans coordinateur central, une revendication perdue ou surenchérie est réattribuée automatiquement",
      "Le rôle contrôle-sol utilise la même image firmware et expose une liaison admin/télémétrie séparée — le logiciel de gestion d'essaim ne touche jamais le format du maillage",
    ],
    specsNote: "Les caractéristiques matérielles précises — dimensions, consommation, tarifs, SKU final — sont encore en cours de finalisation. Tout ce qui précède est déjà réel et vérifié, pas projeté : le runtime de coordination, le maillage, et la logique de mission qu'il exécute aujourd'hui.",
    useCasesTitle: 'Cas d’usage',
    useCases: [
      "Flottes SAR et défense ayant besoin d'une coordination qui survit à une liaison dégradée ou brouillée, pas seulement quand tout fonctionne",
      "Standardiser la coordination sur une flotte hétérogène sans intégration sur mesure par appareil",
      "Ajouter un comportement d'essaim — recherche, revendication, livraison — à un autopilote existant sans toucher à son code de vol",
    ],
    archTitle: "Comment il s'intègre à un appareil existant",
    archLede: "Une seule image firmware. Le maillage continue de coordonner même si la liaison vers cette station sol est dégradée ou coupée — cette liaison n'a jamais été critique.",
    goapTitle: 'GOAP — comment la logique de mission fonctionne réellement',
    goapLede: "Les objectifs et les actions sont écrits comme des données, pas comme un flux de contrôle codé en dur : chaque objectif porte une condition de satisfaction et un score d'utilité, chaque action une précondition et un effet. Le planificateur choisit simplement l'objectif atteignable le mieux noté à l'instant présent et cherche un chemin pour l'atteindre. Quand le monde change — une cible trouvée, une cellule déjà revendiquée, une liaison dégradée — il replanifie depuis le nouvel état plutôt que d'avoir besoin d'un cas explicite pour chaque situation. Ajouter un nouveau comportement de mission revient à ajouter un objectif et une action, pas à toucher au planificateur ni au firmware, et cela peut être envoyé sur le maillage à un drone en vol sans reflash.",
    editorTag: 'RÉDACTION DE MISSION',
    editorTitle: 'Ce que fleece peut composer : loiter, discover, deliver',
    editorLede: "fleece GOAP Studio permet de construire un plan comme celui-ci de zéro : trois actions et trois objectifs, chacun avec sa courbe d'utilité, rien câblé à la main — tenir la position tant qu'il n'y a rien à faire, découvrir des cibles sur une cellule de grille assignée, puis livrer à chacune trouvée. C'est le modèle de rédaction général de fleece — objectifs et actions comme données, de la même façon qu'un tiers construisant directement sur fleece le ferait. Le SPU livre aujourd'hui quelque chose de plus restreint : une bibliothèque d'actions fixe et compilée (takeoff, goto, return_home, scan, deliver), donc une mission sur le matériel SPU est une donnée d'objectif poussée vers cette bibliothèque, pas un plan sur mesure.",
    editorNote: "Décrit le modèle de rédaction général de fleece, pas la façon dont les missions SPU sont rédigées aujourd'hui — voir les caractéristiques ci-dessus pour ce que le SPU livre réellement.",
    autonomyTag: 'AUTONOMIE',
    autonomyTitle: "Un envoi suffit. La liaison n'a jamais été critique.",
    autonomyLede: "Poussez un plan depuis le GC-SPU et il voyage sur le maillage jusqu'à chaque unité en vol, une seule fois — pas un flux de commandes, pas une boucle de contrôle en direct. C'est le modèle général de fleece. Le SPU en livre aujourd'hui une version plus restreinte : des objectifs, pas un plan sur mesure, voyagent de la même façon sur le même maillage vers une bibliothèque d'actions fixe déjà présente sur chaque unité — poussés une fois chacun, récupérés, et poursuivis indépendamment à partir de là. Dans les deux cas, une fois sur le maillage, chaque unité planifie et replanifie seule, directement depuis l'état du monde partagé, propagé de pair à pair. Perdre la liaison avec l'opérateur ne met rien en pause : la façon dont une unité planifie n'a jamais dépendu de cette liaison, donc il n'y a rien vers quoi basculer.",
    autonomyBeforeLabel: 'ENVOI — UNE SEULE FOIS, SUR LE MAILLAGE',
    autonomyAfterLabel: "LIAISON COUPÉE — CHAQUE UNITÉ PLANIFIE ET COORDONNE TOUJOURS",
    gcsTag: 'CONTRÔLE SOL',
    gcsTitle: "La même carte fait aussi office de station sol",
    gcsLede: "Il n'y a pas de produit contrôle-sol séparé. On flashe la même image firmware SPU, on définit son rôle sur contrôle-sol à la configuration, et elle devient un GC-SPU — un pair du maillage qui se trouve simplement sur le bureau de l'opérateur plutôt que sur une cellule. Il expose une image tactique temps réel via sa propre liaison admin/télémétrie : position et cap de chaque unité, batterie, budget de liaison, état de mission, un seul modèle du monde synchronisé directement depuis le gossip du maillage — pas un tableau de bord cloud qui interroge une base de données.",
    gcsPoints: [
      "Chaque unité que le maillage entend apparaît en direct — position, cap, batterie, stats de liaison — sur une vraie carte, pas un schéma",
      "Cliquez sur une unité pour voir sa télémétrie complète ; dessinez des zones et des points d'intérêt directement sur la carte pour que l'essaim y réagisse",
      "Rédigez ou téléversez un plan de mission GOAP et poussez-le vers une unité en vol via le maillage — sans reflash, sans protocole spécifique côté maillage pour la station sol",
      "Fonctionne entièrement à partir de l'état gossip du maillage — sans internet, sans backend cloud, rien à déployer au-delà du GC-SPU lui-même",
    ],
    gcsImgOverviewAlt: 'Carte tactique du contrôle-sol swarmpu — une unité suivie en direct sur une géographie réelle, HUD sombre',
    gcsImgSelectedAlt: "Carte tactique du contrôle-sol swarmpu avec une unité sélectionnée, télémétrie de batterie et de liaison en direct",
    roadmapTag: 'FEUILLE DE ROUTE — PAS ENCORE LIVRÉ',
    roadmapTitle: "Prochaine étape : découverte de cibles pilotée par capteur",
    roadmapLede: "En cours de conception, volontairement séparé des caractéristiques ci-dessus : rien ici n'est construit ni vérifié. L'idée — une charge utile capteur externe (une caméra couplée à une centrale inertielle, intégrée de la même façon que l'autopilote : une liaison dédiée, ni possédée ni exécutée par le SPU) émet un rayon de visée vers une cible détectée plutôt qu'une position devinée. Les rayons de plusieurs unités circulent sur le même état partagé que tout le reste du maillage ; à mesure que d'autres rayons arrivent pour la même cible, leur triangulation converge vers une estimation de position. Une fois suffisamment fiable, cette estimation devient un objectif ordinaire dans la même enchère que celle décrite plus haut — pas de nouveau mécanisme de coordination, juste un objectif de plus qu'une unité peut revendiquer et poursuivre.",
    roadmapPoints: [
      "Le SPU n'exécute jamais le modèle de détection ni ne possède la charge utile capteur — même relation qu'avec l'autopilote",
      "Un seul rayon n'est pas une position : la confiance se construit à mesure que les rayons s'accumulent et que la géométrie s'améliore, pas dès la première détection",
      "Une fois triangulée, la cible est un objectif comme un autre — revendiqué, contesté, réattribué en cas de perte, via la même enchère",
    ],
    ctaTitle: 'Besoin d’une fiche technique, d’un devis, ou d’en discuter ?',
    ctaBody: "Parlez-nous de votre plateforme, de la taille de votre flotte, ou de ce que vous coordonnez — on vous envoie les détails.",
    ctaButton: 'Nous contacter',
    seeAlso: 'La coordination derrière ceci, c’est ',
    seeAlsoLink: 'fleece',
    seeAlsoRest: " — notre propre runtime, et son propre produit.",
  },
};

const c = copy[lang];
---

<section class="container mx-auto px-5 py-16 sm:py-20">
  <a href={localePath(lang, '/products')} class="font-mono text-sm text-blue-400">{c.back}</a>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <h1 class="font-display text-3xl font-semibold sm:text-4xl">{c.name}</h1>
    <span class="tag pointer-events-none">{c.tag}</span>
  </div>
  <p class="mt-2 max-w-2xl text-blue-400">{c.tagline}</p>
  <p class="mt-4 max-w-2xl text-sm text-muted">{c.body}</p>

  <div class="mt-8 overflow-hidden rounded-md border border-line bg-panel">
    <img
      src="/assets/products/spu-render.webp"
      alt="SPU companion computer — black anodized enclosure with status LEDs, SMA antenna connector, and dual JST wiring harness ports"
      width="1200"
      height="655"
      class="w-full"
    />
  </div>

  <div class="mt-10 rounded-md border border-blue-500/30 bg-panel p-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div>
        <h3 class="font-display text-base font-semibold">{c.specsTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.specs.map((s) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">{c.specsNote}</p>
      </div>
      <div>
        <h3 class="font-display text-base font-semibold">{c.useCasesTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.useCases.map((u) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{u}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        ~/spu/architecture.svg
      </div>
      <div class="p-5">
        <h3 class="font-display text-base font-semibold">{c.archTitle}</h3>
        <svg viewBox="0 0 820 280" class="mt-4 h-auto w-full" role="img" aria-label={c.archTitle} font-family="var(--font-mono)">
          <defs>
            <marker id="spuArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#1158ff"/>
            </marker>
          </defs>

          <rect x="16" y="55" width="140" height="70" rx="3" fill="none" stroke="var(--border)" stroke-width="1.25" stroke-dasharray="4 3"/>
          <text x="86" y="86" fill="var(--fg)" font-size="11" text-anchor="middle" letter-spacing="0.5">AUTOPILOT</text>
          <text x="86" y="103" fill="var(--muted)" font-size="8.5" text-anchor="middle">PX4 · ARDUPILOT</text>
          <text x="86" y="115" fill="var(--muted)" font-size="8.5" text-anchor="middle">MSP</text>

          <line x1="158" y1="90" x2="202" y2="90" stroke="#1158ff" stroke-width="1.75" marker-end="url(#spuArrow)"/>
          <text x="180" y="80" fill="var(--muted)" font-size="8" text-anchor="middle">MAVLINK</text>

          <rect x="206" y="45" width="140" height="90" rx="3" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="276" y="72" fill="#1158ff" font-size="11.5" font-weight="600" text-anchor="middle" letter-spacing="1">SPU</text>
          <text x="276" y="90" fill="var(--fg)" font-size="8.5" text-anchor="middle">fleece runtime</text>
          <text x="276" y="103" fill="var(--fg)" font-size="8.5" text-anchor="middle">+ GOAP brain</text>
          <text x="276" y="122" fill="var(--muted)" font-size="7" text-anchor="middle">THIS AIRCRAFT</text>

          <line x1="348" y1="90" x2="424" y2="90" stroke="#1158ff" stroke-width="1.75"/>
          <line x1="546" y1="90" x2="622" y2="90" stroke="#1158ff" stroke-width="1.75"/>
          <text x="486" y="80" fill="var(--muted)" font-size="8" text-anchor="middle">MESH</text>

          <rect x="426" y="45" width="120" height="90" rx="3" fill="var(--surface-2)" stroke="#1158ff" stroke-width="1.1"/>
          <text x="486" y="72" fill="var(--fg)" font-size="10" text-anchor="middle" letter-spacing="0.5">SPU</text>
          <text x="486" y="90" fill="var(--muted)" font-size="7.5" text-anchor="middle">same image,</text>
          <text x="486" y="102" fill="var(--muted)" font-size="7.5" text-anchor="middle">another aircraft</text>
          <text x="486" y="122" fill="var(--muted)" font-size="7" text-anchor="middle">+ MORE PEERS</text>

          <rect x="626" y="45" width="150" height="90" rx="3" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="701" y="72" fill="#1158ff" font-size="10" text-anchor="middle" letter-spacing="0.5">SPU</text>
          <text x="701" y="90" fill="var(--fg)" font-size="8.5" text-anchor="middle">ground-control role</text>
          <text x="701" y="103" fill="var(--muted)" font-size="7.5" text-anchor="middle">same firmware image</text>
          <text x="701" y="122" fill="var(--muted)" font-size="7" text-anchor="middle">GC-SPU</text>

          <text x="486" y="155" fill="var(--muted)" font-size="8" text-anchor="middle">RETICULUM MESH RADIO — NO INTERNET, NO CLOUD, NO SINGLE POINT OF FAILURE</text>

          <line x1="701" y1="135" x2="701" y2="180" stroke="#1158ff" stroke-width="1.75" marker-end="url(#spuArrow)"/>
          <text x="711" y="162" fill="var(--muted)" font-size="7.5">ADMIN /</text>
          <text x="711" y="173" fill="var(--muted)" font-size="7.5">TELEMETRY</text>

          <rect x="601" y="184" width="200" height="64" rx="3" fill="none" stroke="var(--border)" stroke-width="1.25" stroke-dasharray="4 3"/>
          <text x="701" y="208" fill="var(--fg)" font-size="10.5" text-anchor="middle" letter-spacing="0.5">GROUND STATION</text>
          <text x="701" y="224" fill="var(--muted)" font-size="8.5" text-anchor="middle">swarm management software</text>
          <text x="701" y="238" fill="var(--muted)" font-size="7.5" text-anchor="middle">never touches the mesh wire format</text>
        </svg>
        <p class="mt-4 text-xs text-muted">{c.archLede}</p>
      </div>
    </div>

    <div class="terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        ~/spu/goap.svg
      </div>
      <div class="p-5">
        <h3 class="font-display text-base font-semibold">{c.goapTitle}</h3>
        <svg viewBox="0 0 820 260" class="mt-4 h-auto w-full" role="img" aria-label={c.goapTitle} font-family="var(--font-mono)">
          <defs>
            <marker id="goapArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#1158ff"/>
            </marker>
          </defs>

          <rect x="20" y="90" width="180" height="80" rx="3" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="110" y="122" fill="var(--fg)" font-size="11" text-anchor="middle" letter-spacing="0.5">WORLD STATE</text>
          <text x="110" y="140" fill="var(--muted)" font-size="8" text-anchor="middle">self + shared, gossip-synced</text>
          <text x="110" y="153" fill="var(--muted)" font-size="8" text-anchor="middle">across the mesh</text>

          <line x1="202" y1="130" x2="290" y2="130" stroke="#1158ff" stroke-width="1.75" marker-end="url(#goapArrow)"/>

          <rect x="294" y="70" width="230" height="120" rx="3" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="409" y="98" fill="#1158ff" font-size="11.5" font-weight="600" text-anchor="middle" letter-spacing="1">PLANNER</text>
          <text x="409" y="122" fill="var(--fg)" font-size="8.5" text-anchor="middle">GOALS — satisfied-when + utility</text>
          <text x="409" y="140" fill="var(--fg)" font-size="8.5" text-anchor="middle">ACTIONS — precondition + effect</text>
          <text x="409" y="164" fill="var(--muted)" font-size="8" text-anchor="middle">picks the highest-utility achievable</text>
          <text x="409" y="177" fill="var(--muted)" font-size="8" text-anchor="middle">goal, searches a path to it</text>

          <line x1="526" y1="130" x2="614" y2="130" stroke="#1158ff" stroke-width="1.75" marker-end="url(#goapArrow)"/>

          <rect x="618" y="90" width="180" height="80" rx="3" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="708" y="122" fill="var(--fg)" font-size="11" text-anchor="middle" letter-spacing="0.5">EXECUTE</text>
          <text x="708" y="140" fill="var(--muted)" font-size="8" text-anchor="middle">next action's platform</text>
          <text x="708" y="153" fill="var(--muted)" font-size="8" text-anchor="middle">binding — flight, sensor, claim</text>

