---

<section class="container mx-auto px-5 py-16 sm:py-20">
  <a href={localePath(lang, '/products')} class="font-mono text-sm text-blue-400">{c.back}</a>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <h1 class="font-display text-3xl font-semibold sm:text-4xl">{c.name}</h1>
    <span class="tag pointer-events-none">{c.tag}</span>
  </div>
  <p class="mt-2 max-w-2xl text-blue-400">{c.tagline}</p>
  <p class="mt-4 max-w-2xl text-sm text-muted">{c.body}</p>

  <div class="mt-8 overflow-hidden rounded-md border border-line bg-panel">
    <img
      src="/assets/products/spu-render.webp"
      alt="SPU companion computer — black anodized enclosure with status LEDs, SMA antenna connector, and dual JST wiring harness ports"
      width="1200"
      height="655"
      class="w-full"
    />
  </div>

  <div class="terminal-window mt-8">
    <div class="terminal-bar">
      <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
      ~/spu/promo.mp4
    </div>
    <video
      src="/assets/products/spu-promo.mp4"
      poster="/assets/products/spu-promo-poster.webp"
      width="1280"
      height="720"
      class="block h-auto w-full bg-black"
      controls
      preload="none"
      playsinline
      aria-label={c.videoLabel}
    ></video>
  </div>
  <p class="mt-2 max-w-3xl text-xs text-muted">{c.videoLabel} · {c.videoCaption}</p>

  <div class="mt-10 rounded-md border border-blue-500/30 bg-panel p-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div>
        <h3 class="font-display text-base font-semibold">{c.specsTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.specs.map((s) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">{c.specsNote}</p>
      </div>
      <div>
        <h3 class="font-display text-base font-semibold">{c.useCasesTitle}</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {c.useCases.map((u) => (
            <li class="flex gap-2">
              <span class="text-blue-500">›</span>
              <span>{u}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-10">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="font-display text-2xl font-semibold">{c.integrationTitle}</h2>
      <span class="tag pointer-events-none">{c.integrationTag}</span>
    </div>
    <p class="mt-3 max-w-2xl text-sm text-muted">{c.integrationLede}</p>
    <ul class="mt-4 space-y-1.5 text-sm text-muted">
      {c.integrationPoints.map((pt) => (
        <li class="flex gap-2">
          <span class="text-blue-500">›</span>
          <span>{pt}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        ~/spu/architecture.svg
      </div>
      <div class="p-5">
        <h3 class="font-display text-base font-semibold">{c.archTitle}</h3>
        <svg viewBox="0 0 820 264" class="mt-4 h-auto w-full" role="img" aria-label={c.archTitle} font-family="var(--font-mono)">
          <defs>
            <marker id="spuArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,1 L9,5 L0,9 z" fill="#1158ff"/>
            </marker>
          </defs>

          <rect x="16" y="44" width="150" height="96" rx="6" fill="none" stroke="var(--border)" stroke-width="1.25" stroke-dasharray="5 3"/>
          <text x="91" y="80" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.8">AUTOPILOT</text>
          <text x="91" y="101" fill="var(--muted)" font-size="9" text-anchor="middle">PX4 · MAVLink</text>
          <text x="91" y="115" fill="var(--muted)" font-size="9" text-anchor="middle">INAV · MSP</text>
          <text x="91" y="132" fill="var(--muted)" font-size="8" text-anchor="middle">your flight stack</text>

          <line x1="166" y1="92" x2="204" y2="92" stroke="#1158ff" stroke-width="1.75" marker-end="url(#spuArrow)"/>
          <text x="185" y="82" fill="var(--muted)" font-size="8.5" text-anchor="middle">UART</text>

          <rect x="206" y="44" width="150" height="96" rx="6" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="281" y="78" fill="#1158ff" font-size="13" font-weight="600" text-anchor="middle" letter-spacing="1">SPU</text>
          <text x="281" y="100" fill="var(--fg)" font-size="9.5" text-anchor="middle">fleece runtime</text>
          <text x="281" y="114" fill="var(--fg)" font-size="9.5" text-anchor="middle">+ GOAP brain</text>
          <text x="281" y="132" fill="var(--muted)" font-size="8" text-anchor="middle">this aircraft</text>

          <line x1="356" y1="92" x2="430" y2="92" stroke="#1158ff" stroke-width="1.5"/>
          <line x1="558" y1="92" x2="632" y2="92" stroke="#1158ff" stroke-width="1.5"/>
          <text x="393" y="84" fill="var(--muted)" font-size="8.5" text-anchor="middle">mesh</text>
          <text x="595" y="84" fill="var(--muted)" font-size="8.5" text-anchor="middle">mesh</text>

          <rect x="432" y="52" width="124" height="80" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="494" y="82" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="494" y="102" fill="var(--muted)" font-size="8.5" text-anchor="middle">same image,</text>
          <text x="494" y="115" fill="var(--muted)" font-size="8.5" text-anchor="middle">another aircraft</text>

          <rect x="634" y="44" width="150" height="96" rx="6" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="709" y="78" fill="#1158ff" font-size="13" font-weight="600" text-anchor="middle" letter-spacing="1">GC-SPU</text>
          <text x="709" y="100" fill="var(--fg)" font-size="9.5" text-anchor="middle">ground-control role</text>
          <text x="709" y="114" fill="var(--muted)" font-size="8.5" text-anchor="middle">same firmware image</text>
          <text x="709" y="132" fill="var(--muted)" font-size="8" text-anchor="middle">at the operator's desk</text>

          <text x="408" y="164" fill="var(--muted)" font-size="9" text-anchor="middle" letter-spacing="1">ENCRYPTED MESH · NO INTERNET · NO CLOUD · NO SINGLE POINT OF FAILURE</text>

          <line x1="709" y1="140" x2="709" y2="184" stroke="#1158ff" stroke-width="1.5" marker-end="url(#spuArrow)"/>
          <text x="719" y="166" fill="var(--muted)" font-size="8" text-anchor="start">operator</text>
          <text x="719" y="177" fill="var(--muted)" font-size="8" text-anchor="start">link</text>

          <rect x="614" y="188" width="190" height="66" rx="6" fill="none" stroke="var(--border)" stroke-width="1.25" stroke-dasharray="5 3"/>
          <text x="709" y="214" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.8">GROUND STATION</text>
          <text x="709" y="232" fill="var(--muted)" font-size="8.5" text-anchor="middle">swarm management software —</text>
          <text x="709" y="244" fill="var(--muted)" font-size="8.5" text-anchor="middle">never touches the mesh wire format</text>
        </svg>
        <p class="mt-4 text-xs text-muted">{c.archLede}</p>
      </div>
    </div>

    <div class="terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        ~/spu/goap.svg
      </div>
      <div class="p-5">
        <h3 class="font-display text-base font-semibold">{c.goapTitle}</h3>
        <svg viewBox="0 0 852 300" class="mt-4 h-auto w-full" role="img" aria-label={c.goapTitle} font-family="var(--font-mono)">
          <defs>
            <marker id="goapArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,1 L9,5 L0,9 z" fill="#1158ff"/>
            </marker>
            <marker id="goapArrowM" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,1 L9,5 L0,9 z" fill="var(--muted)"/>
            </marker>
          </defs>

          <path d="M714,86 C714,44 96,44 96,86" fill="none" stroke="#1158ff" stroke-width="1.4" marker-end="url(#goapArrow)"/>
          <text x="405" y="40" fill="var(--muted)" font-size="9" text-anchor="middle" letter-spacing="1.4">EFFECTS UPDATE WORLD STATE</text>

          <rect x="16" y="86" width="150" height="92" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="91" y="120" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.5">WORLD STATE</text>
          <text x="91" y="142" fill="var(--muted)" font-size="9" text-anchor="middle">self + shared,</text>
          <text x="91" y="156" fill="var(--muted)" font-size="9" text-anchor="middle">peer-replicated</text>

          <line x1="166" y1="132" x2="192" y2="132" stroke="#1158ff" stroke-width="1.75" marker-end="url(#goapArrow)"/>

          <rect x="194" y="86" width="164" height="92" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="276" y="118" fill="var(--fg)" font-size="11.5" text-anchor="middle" letter-spacing="0.5">FEASIBILITY GATE</text>
          <text x="276" y="139" fill="var(--muted)" font-size="9" text-anchor="middle">deadline reachable?</text>
          <text x="276" y="153" fill="var(--muted)" font-size="8.5" text-anchor="middle">kinematic time-to-go</text>

          <line x1="358" y1="132" x2="384" y2="132" stroke="#1158ff" stroke-width="1.75" marker-end="url(#goapArrow)"/>

          <line x1="276" y1="178" x2="276" y2="228" stroke="var(--muted)" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#goapArrowM)"/>
          <text x="286" y="205" fill="var(--muted)" font-size="8" text-anchor="start">✕ can't reach in time</text>
          <rect x="194" y="230" width="164" height="52" rx="6" fill="none" stroke="var(--border)" stroke-width="1.25" stroke-dasharray="5 3"/>
          <text x="276" y="253" fill="var(--muted)" font-size="10" text-anchor="middle" letter-spacing="0.5">REFUSED</text>
          <text x="276" y="269" fill="var(--muted)" font-size="8" text-anchor="middle">never claimed · no bid spent</text>

          <rect x="386" y="74" width="216" height="116" rx="6" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="494" y="104" fill="#1158ff" font-size="12.5" font-weight="600" text-anchor="middle" letter-spacing="1">BOUNDED PLANNER</text>
          <text x="494" y="127" fill="var(--fg)" font-size="9" text-anchor="middle">A* · hard per-tick node budget</text>
          <text x="494" y="143" fill="var(--fg)" font-size="9" text-anchor="middle">highest-score reachable goal</text>
          <text x="494" y="165" fill="var(--muted)" font-size="8.5" text-anchor="middle">searches a path, then replans</text>
          <text x="494" y="178" fill="var(--muted)" font-size="8.5" text-anchor="middle">in place when it no longer holds</text>

          <line x1="602" y1="132" x2="628" y2="132" stroke="#1158ff" stroke-width="1.75" marker-end="url(#goapArrow)"/>

          <rect x="630" y="86" width="168" height="92" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="714" y="120" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.5">EXECUTE</text>
          <text x="714" y="142" fill="var(--muted)" font-size="9" text-anchor="middle">next action's platform</text>
          <text x="714" y="156" fill="var(--muted)" font-size="9" text-anchor="middle">flight · sensor · claim</text>
        </svg>
        <p class="mt-4 text-xs text-muted">{c.goapLede}</p>
      </div>
    </div>
  </div>

  <div class="mt-14">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="font-display text-2xl font-semibold">{c.editorTitle}</h2>
      <span class="tag pointer-events-none">{c.editorTag}</span>
    </div>
    <p class="mt-3 max-w-2xl text-sm text-muted">{c.editorLede}</p>
    <div class="mt-6 terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        ~/spu/loom.svg
      </div>
      <div class="p-5">
        <svg viewBox="0 0 820 236" class="h-auto w-full" role="img" aria-label={c.editorTitle} font-family="var(--font-mono)">
          <defs>
            <marker id="loomArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,1 L9,5 L0,9 z" fill="#1158ff"/>
            </marker>
          </defs>
          <rect x="16" y="40" width="170" height="112" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="101" y="72" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">MISSION PLAN</text>
          <text x="101" y="94" fill="var(--fg)" font-size="10" text-anchor="middle">written in Loom</text>
          <text x="101" y="116" fill="var(--muted)" font-size="8.5" text-anchor="middle">phases · waits · approvals</text>
          <text x="101" y="130" fill="var(--muted)" font-size="8.5" text-anchor="middle">sync · payload · alerts</text>
          <line x1="186" y1="96" x2="240" y2="96" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loomArrow)"/>
          <text x="213" y="86" fill="var(--muted)" font-size="8.5" text-anchor="middle">compile</text>
          <rect x="250" y="48" width="180" height="112" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <rect x="246" y="44" width="180" height="112" rx="6" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="336" y="76" fill="#1158ff" font-size="13" font-weight="600" text-anchor="middle" letter-spacing="1">GOALS</text>
          <text x="336" y="98" fill="var(--fg)" font-size="10" text-anchor="middle">start condition</text>
          <text x="336" y="114" fill="var(--fg)" font-size="10" text-anchor="middle">test of done · bid</text>
          <text x="336" y="136" fill="var(--muted)" font-size="8.5" text-anchor="middle">no plan inside</text>
          <line x1="426" y1="100" x2="486" y2="100" stroke="#1158ff" stroke-width="1.75" marker-end="url(#loomArrow)"/>
          <text x="456" y="90" fill="var(--muted)" font-size="8.5" text-anchor="middle">once</text>
          <rect x="496" y="58" width="96" height="84" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="544" y="88" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="544" y="108" fill="var(--muted)" font-size="8.5" text-anchor="middle">unit A</text>
          <text x="544" y="124" fill="var(--muted)" font-size="8.5" text-anchor="middle">plans ↻</text>
          <rect x="598" y="58" width="96" height="84" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="646" y="88" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="646" y="108" fill="var(--muted)" font-size="8.5" text-anchor="middle">unit B</text>
          <text x="646" y="124" fill="var(--muted)" font-size="8.5" text-anchor="middle">plans ↻</text>
          <rect x="700" y="58" width="96" height="84" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="748" y="88" fill="var(--fg)" font-size="13" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="748" y="108" fill="var(--muted)" font-size="8.5" text-anchor="middle">unit C</text>
          <text x="748" y="124" fill="var(--muted)" font-size="8.5" text-anchor="middle">plans ↻</text>
          <line x1="592" y1="100" x2="598" y2="100" stroke="#1158ff" stroke-width="1.5"/>
          <line x1="694" y1="100" x2="700" y2="100" stroke="#1158ff" stroke-width="1.5"/>
          <path d="M544,142 C544,176 748,176 748,142" fill="none" stroke="#1158ff" stroke-width="1.3"/>
          <text x="646" y="196" fill="var(--muted)" font-size="8.5" text-anchor="middle" letter-spacing="1">CONDITIONS CHECKED ABOARD</text>
          <text x="410" y="226" fill="var(--muted)" font-size="8.5" text-anchor="middle" letter-spacing="1">PREVIEW · DRY RUN · FOLLOW LIVE — FROM THE GROUND STATION, NEVER RUN FROM IT</text>
        </svg>
      </div>
    </div>
    <div class="mt-6 rounded-md border border-line bg-panel p-6">
      <h3 class="font-display text-base font-semibold">{c.studioTitle}</h3>
      <p class="mt-2 max-w-2xl text-sm text-muted">{c.studioLede}</p>
      <ul class="mt-3 space-y-1.5 text-sm text-muted">
        {c.studioPoints.map((pt) => (
          <li class="flex gap-2">
            <span class="text-blue-500">›</span>
            <span>{pt}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-muted">
        {c.studioMore}<a href="/notes/loom-missions-as-facts" class="accent-link">{c.studioMoreLink}</a>
      </p>
    </div>
  </div>

  <div class="mt-14">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="font-display text-2xl font-semibold">{c.autonomyTitle}</h2>
      <span class="tag pointer-events-none">{c.autonomyTag}</span>
    </div>
    <p class="mt-3 max-w-2xl text-sm text-muted">{c.autonomyLede}</p>

    <div class="mt-6 terminal-window">
      <div class="terminal-bar">
        <span class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></span>
        ~/spu/autonomy.svg
      </div>
      <div class="p-5">
        <svg viewBox="0 0 820 356" class="h-auto w-full" role="img" aria-label={c.autonomyTitle} font-family="var(--font-mono)">
          <defs>
            <marker id="autoArrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,1 L9,5 L0,9 z" fill="#1158ff"/>
            </marker>
          </defs>

          <text x="410" y="20" fill="var(--muted)" font-size="10" text-anchor="middle" letter-spacing="1.4">{c.autonomyBeforeLabel}</text>

          <rect x="24" y="36" width="150" height="84" rx="6" fill="var(--surface-2)" stroke="#1158ff" stroke-width="2"/>
          <text x="99" y="66" fill="#1158ff" font-size="12.5" font-weight="600" text-anchor="middle" letter-spacing="1">GC-SPU</text>
          <text x="99" y="88" fill="var(--muted)" font-size="9" text-anchor="middle">introduces the goals</text>
          <text x="99" y="102" fill="var(--muted)" font-size="9" text-anchor="middle">into the pool</text>

          <line x1="174" y1="78" x2="252" y2="78" stroke="#1158ff" stroke-width="1.75" marker-end="url(#autoArrow)"/>
          <text x="213" y="68" fill="var(--muted)" font-size="8.5" text-anchor="middle">goals</text>
          <line x1="252" y1="78" x2="640" y2="78" stroke="#1158ff" stroke-width="1.5"/>

          <rect x="254" y="36" width="120" height="84" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="314" y="72" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="314" y="92" fill="var(--muted)" font-size="9" text-anchor="middle">unit A</text>
          <rect x="384" y="36" width="120" height="84" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="444" y="72" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="444" y="92" fill="var(--muted)" font-size="9" text-anchor="middle">unit B</text>
          <rect x="514" y="36" width="120" height="84" rx="6" fill="var(--surface-2)" stroke="var(--border)" stroke-width="1.25"/>
          <text x="574" y="72" fill="var(--fg)" font-size="12" text-anchor="middle" letter-spacing="0.8">SPU</text>
          <text x="574" y="92" fill="var(--muted)" font-size="9" text-anchor="middle">unit C</text>

          <line x1="24" y1="156" x2="796" y2="156" stroke="var(--border)" stroke-width="1" stroke-dasharray="3 4"/>

          <text x="410" y="190" fill="var(--muted)" font-size="10" text-anchor="middle" letter-spacing="1.4">{c.autonomyAfterLabel}</text>

          <rect x="24" y="206" width="150" height="84" rx="6" fill="none" stroke="var(--border)" stroke-width="1.25" stroke-dasharray="5 3"/>
          <text x="99" y="240" fill="var(--muted)" font-size="12" text-anchor="middle" letter-spacing="0.8">GC-SPU</text>
          <text x="99" y="260" fill="var(--muted)" font-size="9" text-anchor="middle">operator gone</text>
          <line x1="182" y1="230" x2="210" y2="266" stroke="var(--muted)" stroke-width="1.75"/>
          <line x1="210" y1="230" x2="182" y2="266" stroke="var(--muted)" stroke-width="1.75"/>

