    ownProtocol: "Your autopilot speaks its own protocol? Each autopilot is one backend module behind a fixed interface. A proprietary binary protocol over UART is the same kind of module, written against your interface spec, and nothing above it changes.",

    compatTitle: 'Works with today',
    compatApTitle: 'Autopilots',
    compatAp: [
      ['PX4', 'MAVLink', 'supported', 'waypoints and vectors, streamed position control'],
      ['INAV', 'MSP', 'supported', 'waypoints; actions it cannot carry out are refused'],
